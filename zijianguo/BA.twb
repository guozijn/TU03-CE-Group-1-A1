      <aliases enabled='yes' />
      <column caption='BA-skill flag' datatype='boolean' name='[Calculation_0683386909069312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(&quot;,&quot; + REPLACE(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;, &quot;, &quot;,&quot;) + &quot;,&quot;,&#10;      &quot;,business analysis,&quot;)&#10;  OR&#10;  CONTAINS(&quot;,&quot; + REPLACE(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;, &quot;, &quot;,&quot;) + &quot;,&quot;,&#10;      &quot;,business analyst,&quot;)&#10;  OR&#10;  CONTAINS(&quot;,&quot; + REPLACE(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;, &quot;, &quot;,&quot;) + &quot;,&quot;,&#10;      &quot;,business analysts,&quot;)' />
      </column>
      <column caption='top10title' datatype='boolean' name='[Calculation_0683386915622914]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(COUNTD([job_link]), &quot;desc&quot;) &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Clean' datatype='string' name='[Calculation_0683386922856451]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
        <calculation class='tableau' formula='TRIM([job_location - Split 1])' />
      </column>
      <column caption='State Clean' datatype='string' name='[Calculation_0683386922975236]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='TRIM([job_location - Split 2])' />
      </column>
      <column caption='project management' datatype='integer' name='[Calculation_0683386930421765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;      IF [Calculation_0683386909069312]&#10;      AND [search_country] = &quot;United States&quot;&#10;      AND CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;project management&quot;)&#10;      THEN [job_link]&#10;      END&#10;  )' />
      </column>
      <column caption='Communication' datatype='integer' name='[Calculation_0683386931040262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;      IF CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;communication&quot;)&#10;      THEN [job_link]&#10;      END&#10;  )' />
      </column>
      <column caption='Data analysis' datatype='integer' name='[Calculation_0683386931208199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;      IF CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;data analysis&quot;)&#10;      THEN [job_link]&#10;      END&#10;  )' />
      </column>
      <column caption='SQL' datatype='integer' name='[Calculation_0683386931302408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;      IF CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;sql&quot;)&#10;      THEN [job_link]&#10;      END&#10;  )' />
      </column>
      <column caption='Problem solving' datatype='integer' name='[Calculation_0683386931384329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;      IF CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;problem solving&quot;)&#10;      OR CONTAINS(LOWER(IFNULL([job_skills], &quot;&quot;)), &quot;problemsolving&quot;)&#10;      THEN [job_link]&#10;      END&#10;  )' />
      </column>
      <column caption='Leadership' datatype='integer' name='[Calculation_0683386932949002]' role='measure' type='quantitative'>
